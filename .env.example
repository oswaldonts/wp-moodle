# ─── Base de datos compartida (MariaDB) ───────────────────────
DB_ROOT_PASSWORD=

# ─── WordPress DB ─────────────────────────────────────────────
WP_DB_NAME=wordpress
WP_DB_USER=wp_user
WP_DB_PASSWORD=

# WordPress site config
WP_URL=http://localhost:8090
WP_TITLE=
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=

# WordPress security keys — generate at: https://api.wordpress.org/secret-key/1.1/salt/
WP_AUTH_KEY=
WP_SECURE_AUTH_KEY=
WP_LOGGED_IN_KEY=
WP_NONCE_KEY=
WP_AUTH_SALT=
WP_SECURE_AUTH_SALT=
WP_LOGGED_IN_SALT=
WP_NONCE_SALT=

# ─── Moodle DB ────────────────────────────────────────────────
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle_user
MOODLE_DB_PASSWORD=

# ─── Moodle site config ───────────────────────────────────────
MOODLE_WWWROOT=http://localhost:8091
MOODLE_SITE_FULLNAME=My Moodle Site
MOODLE_SITE_SHORTNAME=moodle

# ─── Moodle Admin ─────────────────────────────────────────────
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=
MOODLE_ADMIN_EMAIL=
